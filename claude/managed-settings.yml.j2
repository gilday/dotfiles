statusLine:
  type: command
  command: >-
    input=$(cat);
    cwd=$(echo "$input" | jq -r '.workspace.current_dir');
    model=$(echo "$input" | jq -r '.model.display_name');
    used=$(echo "$input" | jq -r '.context_window.used_percentage // empty');
    dir_name=$(basename "$cwd");
    git_status="";
    if git -C "$cwd" rev-parse --git-dir >/dev/null 2>&1; then
      branch=$(git -C "$cwd" symbolic-ref --quiet --short HEAD 2>/dev/null || git -C "$cwd" rev-parse --short HEAD 2>/dev/null);
      if [[ -n "$branch" ]]; then
        if git -C "$cwd" --no-optional-locks status --short 2>/dev/null | grep -q '^'; then
          git_status=$(printf '\033[36m(\033[0m%s\033[33m) ✗\033[0m ' "$branch");
        else
          git_status=$(printf '\033[36m(\033[0m%s\033[32m) ✔\033[0m ' "$branch");
        fi;
      fi;
    fi;
    context_info="";
    if [[ -n "$used" ]]; then
      context_info=$(printf '\033[35m[%s%% ctx]\033[0m ' "$used");
    fi;
    rate_info="";
    five_pct=$(echo "$input" | jq -r '.rate_limits.five_hour.used_percentage // empty');
    five_resets=$(echo "$input" | jq -r '.rate_limits.five_hour.resets_at // empty');
    if [[ -n "$five_pct" ]]; then
      filled=$(echo "$five_pct" | awk '{printf "%d", ($1 / 10 + 0.5)}');
      empty=$((10 - filled));
      bar="";
      for ((i = 0; i < filled; i++)); do bar="${bar}▓"; done;
      for ((i = 0; i < empty; i++)); do bar="${bar}░"; done;
      if (( $(echo "$five_pct >= 80" | bc -l) )); then
        color="\033[31m";
      elif (( $(echo "$five_pct >= 50" | bc -l) )); then
        color="\033[33m";
      else
        color="\033[32m";
      fi;
      reset_str="";
      if [[ -n "$five_resets" ]]; then
        now=$(date +%s);
        diff=$((five_resets - now));
        if (( diff > 0 )); then
          hrs=$((diff / 3600));
          mins=$(( (diff % 3600) / 60 ));
          if (( hrs > 0 )); then
            reset_str=$(printf ' ~%dh%02dm' "$hrs" "$mins");
          else
            reset_str=$(printf ' ~%dm' "$mins");
          fi;
        fi;
      fi;
      rate_info=$(printf "${color}[%s%s]\033[0m " "$bar" "$reset_str");
    fi;
    printf '\033[34m%s\033[0m %s%s%s\033[35m%s\033[0m' "$dir_name" "$git_status" "$context_info" "$rate_info" "$model"

tui: fullscreen

env:
  GIT_CONFIG_GLOBAL: "{{ home_dir }}/.gitconfig-claude"
  SSH_AUTH_SOCK: "{{ home_dir }}/.ssh/claude-agent.sock"

permissions:
  allow:
    - "Bash(ntfy:*)"
    - "Bash(git add:*)"
    - "Bash(git commit:*)"
    - "Bash(git push:*)"
    - "Bash(git status:*)"
    - "Bash(git log:*)"
    - "Bash(git show:*)"
    - "Bash(git diff:*)"
    - "Bash(git fetch:*)"
    - "Bash(gh search:*)"
    - "mcp__claude_ai_Granola__get_meeting_transcript"
    - "mcp__claude_ai_Granola__get_meetings"
    - "mcp__claude_ai_Granola__list_meeting_folders"
    - "mcp__claude_ai_Granola__list_meetings"
    - "mcp__claude_ai_Granola__query_granola_meetings"
    - "Read(~/.claude/skills/reviewing-pull-requests/TONE.md)"

sandbox:
  enabled: true
  autoAllowBashIfSandboxed: true
  allowUnsandboxedCommands: false
  enableWeakerNetworkIsolation: true
  excludedCommands:
    - "git:*"
    - "npx:*"
    - "ntfy:*"
    - "open:*"
{% for script in claude_sandbox_scripts.files %}
    - "{{ script.path | replace(home_dir, '~') }}:*"
{% endfor %}
  filesystem:
    allowWrite:
      - "~/.ansible"
      - "~/.gradle"
      - "~/.npm"
  network:
    allowLocalBinding: true
    allowedDomains:
      - "*.devrev.ai"
      - "*.getpixee.com"
      - "api.github.com"
      - "github.com"
      - "registry.npmjs.org"
      - "services.gradle.org"
    allowUnixSockets:
      - "{{ lookup('env', 'SSH_AUTH_SOCK') }}"
      - "{{ home_dir }}/.ssh/claude-agent.sock"
