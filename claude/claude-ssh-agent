#!/bin/bash
# LaunchAgent entrypoint: runs a dedicated ssh-agent at a fixed socket and
# loads the Claude agent-signing key by piping it directly from 1Password
# into ssh-add. The private key never touches disk on this machine.
#
# Used only by Claude Code sessions (SSH_AUTH_SOCK is overridden to this
# socket via ~/.claude/settings.json). Interactive shells continue to use
# the 1Password SSH agent socket exported by 1password/1password.zsh.
#
# Requires 1Password's "Integrate with 1Password CLI" toggle and the desktop
# app unlocked. If the key cannot be loaded within the retry window, the
# agent stays up empty so a manual `just claude-agent-reload` can populate it.

set -euo pipefail

# launchd hands us a minimal PATH (/usr/bin:/bin:/usr/sbin:/sbin), so `op`
# under Homebrew is invisible at login and the key load fails silently until
# the next `just provision` reloads this agent from an interactive shell.
# Pin the Homebrew prefixes explicitly rather than inheriting the caller's.
export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"

AGENT_SOCK="$HOME/.ssh/claude-agent.sock"
OP_SECRET="op://Employee/Claude Code/private_key?ssh-format=openssh"

# At login, 1Password's desktop app may not have finished launching, and it
# stays locked until the user authenticates. Keep retrying so the agent
# populates itself as soon as the vault becomes reachable, instead of leaving
# signing broken for the rest of the session.
load_key() {
  local attempt
  for attempt in $(seq 1 40); do
    if op --account pixee.1password.com read --no-newline "$OP_SECRET" \
         | SSH_AUTH_SOCK="$AGENT_SOCK" /usr/bin/ssh-add - 2>&1; then
      echo "claude-ssh-agent: key loaded on attempt ${attempt}"
      return 0
    fi
    echo "claude-ssh-agent: attempt ${attempt} failed (1Password locked or unavailable); retrying in 15s"
    sleep 15
  done
  echo "claude-ssh-agent: giving up after ${attempt} attempts; agent is running but empty"
  return 0
}

rm -f "$AGENT_SOCK"
/usr/bin/ssh-agent -D -a "$AGENT_SOCK" &
AGENT_PID=$!
while [ ! -S "$AGENT_SOCK" ]; do sleep 0.1; done

# Background the retry loop so a locked vault never delays the agent itself.
load_key &

wait "$AGENT_PID"
