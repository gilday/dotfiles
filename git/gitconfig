[alias]
	amend = commit --amend --no-edit
	force-pull = "!git fetch ; git reset --hard @{u}"
	s = status
	yeet = push --force-with-lease

[color]
	ui = true

[push]
	default = simple
	autoSetupRemote = true

[core]
	ignorecase = false

[credential]
	helper = cache --timeout=300

[merge]
	tool = kdiff3

[mergetool "kdiff3"]
	path = kdiff3
	trustExitCode = false
	keepBackup = false

[mergetool "meld"]
	trustExitCode = false
	cmd = meld $LOCAL $BASE $REMOTE -o $MERGED --auto-merge

[pull]
	rebase = true

[init]
        defaultBranch = main

# Include identity configuration if it exists
[include]
	path = ~/.gitconfig-identity